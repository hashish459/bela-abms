# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="postgresql://postgres@localhost:5432/bela_abms?schema=public"

# Auth — generate strong random values for any real deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# Cookies
COOKIE_SECURE="false"   # true in production (HTTPS)

# AES-256-GCM key material for encrypting stored secrets (e.g. IRD CBMS password).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="dev-app-secret-change-me"

NODE_ENV="development"
