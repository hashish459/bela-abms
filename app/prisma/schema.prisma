// Bela ABMS — platform schema (Phase 3 foundation).
// Domain entities (invoices, products, vouchers, …) are added module-by-module later;
// see Docs/DATABASE.md. Only observed structures are modelled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ─────────────────────────────  TENANCY  ─────────────────────────────

model Company {
  id                   String    @id @default(cuid())
  name                 String
  subdomain            String    @unique
  address              String?
  allowsBranchCreation Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  branches             Branch[]
  fiscalYears          FiscalYear[]
  taxRates             TaxRate[]
  info                 CompanyInfo?
  roles                Role[]
  userLinks            UserCompany[]
  auditLogs            AuditLog[]
  reminders            Reminder[]
  notifications        Notification[]
  accountHeads         AccountHead[]
  accountGroups        AccountGroup[]
  ledgers              Ledger[]
  vouchers             Voucher[]
  productCategories    ProductCategory[]
  units                Unit[]
  warehouses           Warehouse[]
  products             Product[]
  productBatches       ProductBatch[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]
  salesDocs            SalesDoc[]
  receipts             Receipt[]
  purchaseDocs         PurchaseDoc[]
  supplierPayments     SupplierPayment[]
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  name      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model FiscalYear {
  id          String   @id @default(cuid())
  companyId   String
  name        String // Bikram Sambat label, e.g. "2083-84"
  startDate   DateTime @db.Date // stored as AD (Gregorian); UI shows BS
  endDate     DateTime @db.Date
  description String?
  active      Boolean  @default(false)
  isClosed    Boolean  @default(false) // year-end closed; opening carried forward
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers         Voucher[]
  salesDocs        SalesDoc[]
  receipts         Receipt[]
  purchaseDocs     PurchaseDoc[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Tax rates ("list published by IRD" in the reference). Nepal: VAT 13% + 0% exempt.
model TaxRate {
  id        String    @id @default(cuid())
  companyId String
  name      String // "VAT 13%", "VAT Exempt", "Non-Taxable"
  ratePct   Decimal   @db.Decimal(7, 4) // 13.0000
  isNoTax   Boolean   @default(false) // "No Tax" flag — excludes from VAT base
  isSystem  Boolean   @default(false) // seeded IRD rate; not deletable
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// One row per company: legal identity, IRD registration, branding assets.
/// Mirrors Settings › Company Info in the reference.
model CompanyInfo {
  id        String @id @default(cuid())
  companyId String @unique

  legalName   String
  displayName String?
  phone       String
  phone2      String?
  email       String
  website     String?
  panNumber   String
  eximCode    String?

  // IRD Central Billing Monitoring System — integration is stubbed in v1 (ASSUMPTIONS A16).
  cbmsUsername             String?
  cbmsPasswordCiphertext   String? // encrypted at rest; never returned to the client
  registeredWithVat        Boolean @default(true)
  separatePurchaseSalesTax Boolean @default(false)
  syncWithIrd              Boolean @default(false)

  registeredAddress  String
  registeredAddress2 String?

  logoUrl      String?
  stampUrl     String?
  paymentQrUrl String?
  signatureUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// ─────────────────────────────  IDENTITY  ────────────────────────────

/// Reference JWT carries user_type "AD" (Admin). Full option set not yet observed
/// (Docs/ASSUMPTIONS.md A7). Kept as free string; ADMIN bypasses permission checks.
model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  passwordHash String
  userType     String     @default("STAFF")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  companyLinks  UserCompany[]
  roleLinks     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  reminders     Reminder[]
  notifications Notification[]
  vouchers      Voucher[]
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

model UserCompany {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  isDefault Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// ────────────────────────  ROLES & PERMISSIONS  ─────────────────────

/// Roles are per-company and free-text named (Admin, Cashier, Retailer, Storekeeper, …).
model Role {
  id        String    @id @default(cuid())
  companyId String
  name      String
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userLinks   UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// The 78 UI modules from Settings › User & Permissions, grouped like the nav.
model PermissionModule {
  id        String @id @default(cuid())
  groupKey  String // "sales", "purchase", …
  groupName String // "Sales"
  key       String @unique // "sales.sales_invoice"
  label     String // "Sales Invoice"
  order     Int    @default(0)

  rolePermissions RolePermission[]

  @@index([groupKey])
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  moduleId  String
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module PermissionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@index([moduleId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// ─────────────────────────────  AUTH  ───────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// ────────────────────────  NAVIGATION (data-driven)  ────────────────

model MenuItem {
  id            String  @id @default(cuid())
  parentId      String?
  title         String
  slug          String  @unique
  route         String?
  icon          String?
  order         Int     @default(0)
  isActive      Boolean @default(true)
  isExternal    Boolean @default(false)
  permissionKey String? // -> PermissionModule.key; null = always visible

  parent   MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuChildren")

  @@index([parentId])
}

/// ────────────────────  ACCOUNTS / GENERAL LEDGER  ───────────────────
/// Mirrors the reference's 3-level NFRS chart of accounts
/// (AccountHead → AccountGroup → Ledger). See Docs/REFERENCE-API-MAP.md.

enum AccountType {
  AS // Assets
  LI // Liabilities
  EQ // Equity
  IN // Income
  EX // Expense
}

enum CurrentType {
  CU // Current
  NC // Non-Current
  O // not applicable (P&L accounts)
}

enum FinancialType {
  FI // Financial
  NF // Non-Financial
  O // not applicable
}

enum BalanceType {
  DR
  CR
}

enum ContactKind {
  CUSTOMER
  SUPPLIER
  BOTH
}

model AccountHead {
  id            String        @id @default(cuid())
  companyId     String
  code          String // "ADE", "CCE", "TRR" …
  name          String
  accountType   AccountType
  currentType   CurrentType   @default(O)
  financialType FinancialType @default(O)
  isSystem      Boolean       @default(false) // NFRS-reserved; not deletable
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groups  AccountGroup[]

  @@unique([companyId, code])
  @@index([companyId, accountType])
}

model AccountGroup {
  id            String   @id @default(cuid())
  companyId     String
  accountHeadId String
  code          String // "ADE-01"
  name          String
  isSystem      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountHead AccountHead @relation(fields: [accountHeadId], references: [id], onDelete: Cascade)
  ledgers     Ledger[]

  @@unique([companyId, code])
  @@index([accountHeadId])
}

/// Level-3 posting account. Customers/suppliers ARE ledgers (under Trade Receivable /
/// Trade Payable), carrying the party fields.
model Ledger {
  id             String      @id @default(cuid())
  companyId      String
  accountGroupId String
  code           String // "CCE-01-0001"
  name           String
  openingBalance Decimal     @default(0) @db.Decimal(18, 2)
  openingType    BalanceType @default(DR)
  isSystem       Boolean     @default(false)
  isActive       Boolean     @default(true)

  // Party fields — populated when this ledger is a customer/supplier contact.
  contactKind ContactKind?
  panNumber   String?
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal?     @db.Decimal(18, 2)
  iecNo       String?
  gstin       String?
  bankName    String?
  bankAccount String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountGroup AccountGroup  @relation(fields: [accountGroupId], references: [id], onDelete: Restrict)
  voucherLines VoucherLine[]

  @@unique([companyId, code])
  @@index([accountGroupId])
  @@index([companyId, contactKind])
}

enum VoucherType {
  OPENING
  JOURNAL
  CONTRA
  STOCK
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  EXPENSE
}

/// Every financial document posts one balanced Voucher via postVoucher(). Reports read
/// VoucherLine, never the source documents.
model Voucher {
  id           String      @id @default(cuid())
  companyId    String
  fiscalYearId String
  number       String // "JV-2083/84-0001"
  date         DateTime    @db.Date
  type         VoucherType
  narration    String?
  sourceType   String? // "SalesInvoice", "Receipt" … null for manual vouchers
  sourceId     String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  createdBy  User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines      VoucherLine[]

  @@unique([companyId, number])
  @@index([companyId, fiscalYearId, date])
  @@index([sourceType, sourceId])
}

model VoucherLine {
  id        String  @id @default(cuid())
  voucherId String
  ledgerId  String
  debit     Decimal @default(0) @db.Decimal(18, 2)
  credit    Decimal @default(0) @db.Decimal(18, 2)
  narration String?
  order     Int     @default(0)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger  Ledger  @relation(fields: [ledgerId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([ledgerId])
}

/// Gap-free sequential numbering per (company, fiscalYear, key). Locked increment.
model NumberSequence {
  id           String  @id @default(cuid())
  companyId    String
  fiscalYearId String?
  key          String // "voucher:JOURNAL", "invoice:SA" …
  nextValue    Int     @default(1)

  @@unique([companyId, fiscalYearId, key])
}

/// ─────────────────────────────  INVENTORY  ──────────────────────────
/// Mirrors the reference Inventory module. Current stock is DERIVED from StockMovement
/// (postStockMovement is the single writer) — never a mutable field.

enum ProductKind {
  GOODS
  SERVICE
  EXPENSE
}

enum ProductTaxBasis {
  INCLUSIVE
  EXCLUSIVE
}

model ProductCategory {
  id          String    @id @default(cuid())
  companyId   String
  parentId    String?
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name])
  @@index([companyId, parentId])
}

model Unit {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  shortName      String
  description    String?
  acceptFraction Boolean  @default(false)
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryFor      Product[] @relation("ProductPrimaryUnit")
  subUnitFor      Product[] @relation("ProductSubUnit")
  tertiaryUnitFor Product[] @relation("ProductTertiaryUnit")

  @@unique([companyId, name])
  @@index([companyId])
}

model Warehouse {
  id        String    @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  batches        ProductBatch[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Product {
  id           String      @id @default(cuid())
  companyId    String
  kind         ProductKind @default(GOODS)
  name         String
  categoryId   String?
  hsnCode      String?
  sku          String
  reorderPoint Decimal?    @db.Decimal(18, 3)
  description  String?

  // Units — up to 3 levels. subUnitConversion = # of sub-units per 1 primary unit
  // (Docs/ASSUMPTIONS.md). tertiaryConversion = # of tertiary per 1 sub-unit.
  unitId             String
  subUnitId          String?
  subUnitConversion  Decimal? @db.Decimal(18, 6)
  tertiaryUnitId     String?
  tertiaryConversion Decimal? @db.Decimal(18, 6)

  purchasePrice Decimal @default(0) @db.Decimal(18, 2)
  sellingPrice  Decimal @default(0) @db.Decimal(18, 2)

  taxRateId    String?
  taxBasis     ProductTaxBasis @default(EXCLUSIVE)
  isNonTaxable Boolean         @default(false)

  // Optional attributes (reference product form)
  size             String?
  color            String?
  flavour          String?
  dftqcNo          String?
  madeImportedFrom String?
  expiryDate       DateTime? @db.Date

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit           Unit             @relation("ProductPrimaryUnit", fields: [unitId], references: [id], onDelete: Restrict)
  subUnit        Unit?            @relation("ProductSubUnit", fields: [subUnitId], references: [id], onDelete: SetNull)
  tertiaryUnit   Unit?            @relation("ProductTertiaryUnit", fields: [tertiaryUnitId], references: [id], onDelete: SetNull)
  taxRate        TaxRate?         @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  batches        ProductBatch[]
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, kind])
  @@index([companyId, categoryId])
}

model ProductBatch {
  id          String    @id @default(cuid())
  companyId   String
  productId   String
  warehouseId String
  batchNo     String
  expiryDate  DateTime? @db.Date
  createdAt   DateTime  @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([companyId, productId, warehouseId, batchNo])
  @@index([productId])
}

enum StockMovementKind {
  OPENING
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  MANUFACTURE_IN
  MANUFACTURE_OUT
}

/// The single source of truth for stock quantity. `qty` is signed
/// (positive = in, negative = out). Current on-hand = Σ qty per (product, warehouse[, batch]).
model StockMovement {
  id           String            @id @default(cuid())
  companyId    String
  fiscalYearId String?
  productId    String
  warehouseId  String
  batchId      String?
  date         DateTime          @db.Date
  kind         StockMovementKind
  qty          Decimal           @db.Decimal(18, 3)
  unitCost     Decimal           @default(0) @db.Decimal(18, 4)
  sourceType   String?
  sourceId     String?
  narration    String?
  createdById  String?
  createdAt    DateTime          @default(now())

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch     ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([companyId, productId, warehouseId])
  @@index([sourceType, sourceId])
  @@index([companyId, date])
}

enum InventoryAdjustmentType {
  INCREASE
  DECREASE
  DAMAGE
  EXPIRY
  RECOUNT
  OPENING
}

model InventoryAdjustment {
  id          String                  @id @default(cuid())
  companyId   String
  number      String
  date        DateTime                @db.Date
  type        InventoryAdjustmentType
  warehouseId String
  notes       String?
  createdById String?
  createdAt   DateTime                @default(now())

  company Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   InventoryAdjustmentLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model InventoryAdjustmentLine {
  id           String  @id @default(cuid())
  adjustmentId String
  productId    String
  batchId      String?
  qty          Decimal @db.Decimal(18, 3) // signed: + increase, - decrease
  order        Int     @default(0)

  adjustment InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
}

/// ───────────────────────────────  SALES  ────────────────────────────
/// Unified sales document (mirrors the reference `/invoices/` with `invoice_type`).
/// QUOTATION / SALES_ORDER are non-accounting drafts. INVOICE / CREDIT_NOTE post GL +
/// stock and are IMMUTABLE once created (Docs/vendor/INVOICE-IMMUTABILITY.txt) —
/// corrections happen only via a CREDIT_NOTE.

enum SalesDocType {
  QUOTATION
  SALES_ORDER
  INVOICE
  CREDIT_NOTE
}

enum SalesDocStatus {
  DRAFT // quotation / sales order, not yet converted
  OPEN // invoice with balance outstanding
  PARTIALLY_PAID
  PAID
  CONVERTED // quotation/SO converted to the next stage
  CANCELLED // credit-noted in full
  RETURNED // partially credit-noted
}

enum PaymentMode {
  CREDIT
  CASH
  BANK
  CHEQUE
  WALLET // eSewa / Khalti / POS
}

model SalesDoc {
  id           String       @id @default(cuid())
  companyId    String
  fiscalYearId String
  type         SalesDocType
  number       String // "SA-2083/84-0001", "QU-…", "CN-…"
  date         DateTime     @db.Date

  // Party — either an existing customer ledger, or a walk-in cash-sale name.
  customerLedgerId String?
  customerName     String? // for cash sales / display snapshot
  customerPan      String?

  deliveryDate    DateTime?   @db.Date
  creditDays      Int?
  referenceNo     String?
  paymentMode     PaymentMode @default(CREDIT)
  paymentLedgerId String? // cash/bank ledger when not on credit
  notes           String?

  convertedFromId String? // quotation → sales order → invoice chain
  reversesDocId   String? // credit note → the invoice it credits

  // Server-authoritative money (Docs/WORKFLOWS.md W4). All Decimal(18,2).
  subtotal          Decimal @default(0) @db.Decimal(18, 2) // Σ line gross (qty×rate)
  lineDiscountTotal Decimal @default(0) @db.Decimal(18, 2)
  invoiceDiscount   Decimal @default(0) @db.Decimal(18, 2) // header-level, on taxable base
  nonTaxableTotal   Decimal @default(0) @db.Decimal(18, 2)
  taxableTotal      Decimal @default(0) @db.Decimal(18, 2) // after all discounts, pre-VAT
  vatAmount         Decimal @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal @default(0) @db.Decimal(18, 2)
  amountPaid        Decimal @default(0) @db.Decimal(18, 2)

  status        SalesDocStatus @default(DRAFT)
  voucherId     String?        @unique // the GL voucher (INVOICE / CREDIT_NOTE only)
  cogsVoucherId String?        @unique
  createdById   String?
  createdAt     DateTime       @default(now())

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  items      SalesDocItem[]
  receipts   Receipt[]

  @@unique([companyId, number])
  @@index([companyId, type, date])
  @@index([customerLedgerId])
  @@index([convertedFromId])
  @@index([reversesDocId])
}

model SalesDocItem {
  id          String  @id @default(cuid())
  docId       String
  productId   String?
  description String // snapshot of product name (products can't be deleted while used, but snapshot anyway)
  hsCode      String?
  batchId     String?
  warehouseId String?

  qty      Decimal @db.Decimal(18, 3)
  rate     Decimal @db.Decimal(18, 4)
  discount Decimal @default(0) @db.Decimal(18, 2) // per-line, absolute

  taxRateId      String?
  taxRatePct     Decimal @default(0) @db.Decimal(7, 4) // snapshot
  isNonTaxable   Boolean @default(false)
  priceInclusive Boolean @default(false)

  // computed, stored for audit
  grossAmount Decimal @db.Decimal(18, 2) // qty × rate
  netAmount   Decimal @db.Decimal(18, 2) // gross − line discount (tax-exclusive base)
  lineVat     Decimal @default(0) @db.Decimal(18, 2)
  order       Int     @default(0)

  doc SalesDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([productId])
}

model Receipt {
  id           String   @id @default(cuid())
  companyId    String
  fiscalYearId String
  number       String // "RC-2083/84-0001"
  date         DateTime @db.Date

  customerLedgerId String
  paymentLedgerId  String // cash / bank ledger
  againstDocId     String? // the invoice being paid (optional — can be on-account)
  amount           Decimal     @db.Decimal(18, 2)
  paymentMode      PaymentMode @default(CASH)
  reference        String?
  notes            String?

  voucherId   String?  @unique
  createdById String?
  createdAt   DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  againstDoc SalesDoc?  @relation(fields: [againstDocId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([customerLedgerId])
}

/// ──────────────────────────────  PURCHASE  ───────────────────────────
/// Mirrors Sales, roles reversed (we are the buyer). Excise/custom duty are
/// CAPITALIZED into landed cost (added to Inventory), not expensed — standard
/// perpetual-inventory treatment. VAT here is Input VAT (Vat Receivable), the
/// mirror image of Sales' VAT Payable. Purchase Invoice is IMMUTABLE; corrections
/// go through a Debit Note (Docs/WORKFLOWS.md W5).

enum PurchaseDocType {
  PURCHASE_ORDER
  INVOICE
  DEBIT_NOTE
}

enum PurchaseDocStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  CONVERTED
  CANCELLED
  RETURNED
}

model PurchaseDoc {
  id           String          @id @default(cuid())
  companyId    String
  fiscalYearId String
  type         PurchaseDocType
  number       String // "PU-2083/84-0001", "PO-…", "DN-…"
  date         DateTime        @db.Date

  supplierLedgerId      String?
  supplierName          String? // display snapshot
  supplierPan           String?
  supplierInvoiceNumber String? // required for INVOICE — the vendor's own bill number

  deliveryDate    DateTime?   @db.Date
  referenceNo     String?
  paymentMode     PaymentMode @default(CREDIT)
  paymentLedgerId String?
  notes           String?

  convertedFromId String? // purchase order → invoice chain
  reversesDocId   String? // debit note → the invoice it debits

  subtotal          Decimal @default(0) @db.Decimal(18, 2)
  lineDiscountTotal Decimal @default(0) @db.Decimal(18, 2)
  invoiceDiscount   Decimal @default(0) @db.Decimal(18, 2)
  totalExciseDuty   Decimal @default(0) @db.Decimal(18, 2)
  totalCustomDuty   Decimal @default(0) @db.Decimal(18, 2)
  nonTaxableTotal   Decimal @default(0) @db.Decimal(18, 2)
  taxableTotal      Decimal @default(0) @db.Decimal(18, 2)
  vatAmount         Decimal @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal @default(0) @db.Decimal(18, 2)
  amountPaid        Decimal @default(0) @db.Decimal(18, 2)

  status      PurchaseDocStatus @default(DRAFT)
  voucherId   String?           @unique
  createdById String?
  createdAt   DateTime          @default(now())

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  items      PurchaseDocItem[]
  payments   SupplierPayment[]

  @@unique([companyId, number])
  @@index([companyId, type, date])
  @@index([supplierLedgerId])
  @@index([convertedFromId])
  @@index([reversesDocId])
}

model PurchaseDocItem {
  id          String  @id @default(cuid())
  docId       String
  productId   String?
  description String
  hsCode      String?
  batchId     String?
  warehouseId String?

  qty        Decimal @db.Decimal(18, 3)
  rate       Decimal @db.Decimal(18, 4)
  discount   Decimal @default(0) @db.Decimal(18, 2)
  exciseDuty Decimal @default(0) @db.Decimal(18, 2)
  customDuty Decimal @default(0) @db.Decimal(18, 2)

  taxRateId    String?
  taxRatePct   Decimal @default(0) @db.Decimal(7, 4)
  isNonTaxable Boolean @default(false)

  grossAmount    Decimal @db.Decimal(18, 2) // qty × rate
  netAmount      Decimal @db.Decimal(18, 2) // gross − line discount
  landedAmount   Decimal @db.Decimal(18, 2) // net + exciseDuty + customDuty — the taxable/capitalized base
  landedUnitCost Decimal @db.Decimal(18, 4) // landedAmount ÷ qty — feeds StockMovement.unitCost
  lineVat        Decimal @default(0) @db.Decimal(18, 2)
  order          Int     @default(0)

  doc PurchaseDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([productId])
}

model SupplierPayment {
  id           String   @id @default(cuid())
  companyId    String
  fiscalYearId String
  number       String // "PM-2083/84-0001"
  date         DateTime @db.Date

  supplierLedgerId String
  paymentLedgerId  String
  againstDocId     String?
  amount           Decimal     @db.Decimal(18, 2)
  paymentMode      PaymentMode @default(CASH)
  reference        String?
  notes            String?

  voucherId   String?  @unique
  createdById String?
  createdAt   DateTime @default(now())

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  againstDoc PurchaseDoc? @relation(fields: [againstDocId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([supplierLedgerId])
}

/// ─────────────────────────────  AUDIT  ──────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  action    String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, …
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

/// ──────────────────────  NOTIFICATION & REMINDER  ───────────────────

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  title       String
  description String?
  remindAt    DateTime
  status      String   @default("PENDING") // PENDING, DONE, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
