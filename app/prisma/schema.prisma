// Bela ABMS — platform schema (Phase 3 foundation).
// Domain entities (invoices, products, vouchers, …) are added module-by-module later;
// see Docs/DATABASE.md. Only observed structures are modelled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ─────────────────────────────  TENANCY  ─────────────────────────────

model Company {
  id                   String    @id @default(cuid())
  name                 String
  subdomain            String    @unique
  address              String?
  allowsBranchCreation Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  branches               Branch[]
  fiscalYears            FiscalYear[]
  taxRates               TaxRate[]
  info                   CompanyInfo?
  roles                  Role[]
  userLinks              UserCompany[]
  auditLogs              AuditLog[]
  reminders              Reminder[]
  notifications          Notification[]
  accountHeads           AccountHead[]
  accountGroups          AccountGroup[]
  ledgers                Ledger[]
  vouchers               Voucher[]
  productCategories      ProductCategory[]
  units                  Unit[]
  warehouses             Warehouse[]
  products               Product[]
  productBatches         ProductBatch[]
  stockMovements         StockMovement[]
  inventoryAdjustments   InventoryAdjustment[]
  salesDocs              SalesDoc[]
  receipts               Receipt[]
  purchaseDocs           PurchaseDoc[]
  supplierPayments       SupplierPayment[]
  fixedAssets            FixedAsset[]
  depreciationRuns       DepreciationRun[]
  billOfMaterials        BillOfMaterial[]
  productionOrders       ProductionOrder[]
  technicians            Technician[]
  jobCards               JobCard[]
  banks                  Bank[]
  bankAccounts           BankAccount[]
  customFields           CustomField[]
  customStatuses         CustomStatus[]
  barcodeSetting         BarcodeSetting?
  invoiceSetting         InvoiceSetting?
  invoiceImportTemplates InvoiceImportTemplate[]
  billFooterSetting      BillFooterSetting?
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  name      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model FiscalYear {
  id          String   @id @default(cuid())
  companyId   String
  name        String // Bikram Sambat label, e.g. "2083-84"
  startDate   DateTime @db.Date // stored as AD (Gregorian); UI shows BS
  endDate     DateTime @db.Date
  description String?
  active      Boolean  @default(false)
  isClosed    Boolean  @default(false) // year-end closed; opening carried forward
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers         Voucher[]
  salesDocs        SalesDoc[]
  receipts         Receipt[]
  purchaseDocs     PurchaseDoc[]
  supplierPayments SupplierPayment[]
  fixedAssets      FixedAsset[]
  depreciationRuns DepreciationRun[]
  productionOrders ProductionOrder[]
  jobCards         JobCard[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Tax rates ("list published by IRD" in the reference). Nepal: VAT 13% + 0% exempt.
model TaxRate {
  id        String    @id @default(cuid())
  companyId String
  name      String // "VAT 13%", "VAT Exempt", "Non-Taxable"
  ratePct   Decimal   @db.Decimal(7, 4) // 13.0000
  isNoTax   Boolean   @default(false) // "No Tax" flag — excludes from VAT base
  isSystem  Boolean   @default(false) // seeded IRD rate; not deletable
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// One row per company: legal identity, IRD registration, branding assets.
/// Mirrors Settings › Company Info in the reference.
model CompanyInfo {
  id        String @id @default(cuid())
  companyId String @unique

  legalName   String
  displayName String?
  phone       String
  phone2      String?
  email       String
  website     String?
  panNumber   String
  eximCode    String?

  // IRD Central Billing Monitoring System — integration is stubbed in v1 (ASSUMPTIONS A16).
  cbmsUsername             String?
  cbmsPasswordCiphertext   String? // encrypted at rest; never returned to the client
  registeredWithVat        Boolean @default(true)
  separatePurchaseSalesTax Boolean @default(false)
  syncWithIrd              Boolean @default(false)

  registeredAddress  String
  registeredAddress2 String?

  logoUrl      String?
  stampUrl     String?
  paymentQrUrl String?
  signatureUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// ─────────────────────────────  IDENTITY  ────────────────────────────

/// Reference JWT carries user_type "AD" (Admin). Full option set not yet observed
/// (Docs/ASSUMPTIONS.md A7). Kept as free string; ADMIN bypasses permission checks.
model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  passwordHash String
  userType     String     @default("STAFF")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  companyLinks  UserCompany[]
  roleLinks     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  reminders     Reminder[]
  notifications Notification[]
  vouchers      Voucher[]
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

model UserCompany {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  isDefault Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// ────────────────────────  ROLES & PERMISSIONS  ─────────────────────

/// Roles are per-company and free-text named (Admin, Cashier, Retailer, Storekeeper, …).
model Role {
  id        String    @id @default(cuid())
  companyId String
  name      String
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userLinks   UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// The 78 UI modules from Settings › User & Permissions, grouped like the nav.
model PermissionModule {
  id        String @id @default(cuid())
  groupKey  String // "sales", "purchase", …
  groupName String // "Sales"
  key       String @unique // "sales.sales_invoice"
  label     String // "Sales Invoice"
  order     Int    @default(0)

  rolePermissions RolePermission[]

  @@index([groupKey])
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  moduleId  String
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module PermissionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@index([moduleId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// ─────────────────────────────  AUTH  ───────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// ────────────────────────  NAVIGATION (data-driven)  ────────────────

model MenuItem {
  id            String  @id @default(cuid())
  parentId      String?
  title         String
  slug          String  @unique
  route         String?
  icon          String?
  order         Int     @default(0)
  isActive      Boolean @default(true)
  isExternal    Boolean @default(false)
  permissionKey String? // -> PermissionModule.key; null = always visible

  parent   MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuChildren")

  @@index([parentId])
}

/// ────────────────────  ACCOUNTS / GENERAL LEDGER  ───────────────────
/// Mirrors the reference's 3-level NFRS chart of accounts
/// (AccountHead → AccountGroup → Ledger). See Docs/REFERENCE-API-MAP.md.

enum AccountType {
  AS // Assets
  LI // Liabilities
  EQ // Equity
  IN // Income
  EX // Expense
}

enum CurrentType {
  CU // Current
  NC // Non-Current
  O // not applicable (P&L accounts)
}

enum FinancialType {
  FI // Financial
  NF // Non-Financial
  O // not applicable
}

enum BalanceType {
  DR
  CR
}

enum ContactKind {
  CUSTOMER
  SUPPLIER
  BOTH
}

model AccountHead {
  id            String        @id @default(cuid())
  companyId     String
  code          String // "ADE", "CCE", "TRR" …
  name          String
  accountType   AccountType
  currentType   CurrentType   @default(O)
  financialType FinancialType @default(O)
  isSystem      Boolean       @default(false) // NFRS-reserved; not deletable
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groups  AccountGroup[]

  @@unique([companyId, code])
  @@index([companyId, accountType])
}

model AccountGroup {
  id            String   @id @default(cuid())
  companyId     String
  accountHeadId String
  code          String // "ADE-01"
  name          String
  isSystem      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountHead AccountHead @relation(fields: [accountHeadId], references: [id], onDelete: Cascade)
  ledgers     Ledger[]

  @@unique([companyId, code])
  @@index([accountHeadId])
}

/// Level-3 posting account. Customers/suppliers ARE ledgers (under Trade Receivable /
/// Trade Payable), carrying the party fields.
model Ledger {
  id             String      @id @default(cuid())
  companyId      String
  accountGroupId String
  code           String // "CCE-01-0001"
  name           String
  openingBalance Decimal     @default(0) @db.Decimal(18, 2)
  openingType    BalanceType @default(DR)
  isSystem       Boolean     @default(false)
  isActive       Boolean     @default(true)

  // Party fields — populated when this ledger is a customer/supplier contact.
  contactKind ContactKind?
  panNumber   String?
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal?     @db.Decimal(18, 2)
  iecNo       String?
  gstin       String?
  bankName    String?
  bankAccount String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountGroup AccountGroup  @relation(fields: [accountGroupId], references: [id], onDelete: Restrict)
  voucherLines VoucherLine[]
  bankAccounts BankAccount[]

  @@unique([companyId, code])
  @@index([accountGroupId])
  @@index([companyId, contactKind])
}

enum VoucherType {
  OPENING
  JOURNAL
  CONTRA
  STOCK
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  EXPENSE
  ASSET
  DEPRECIATION
  ASSET_DISPOSAL
  MANUFACTURE
}

/// Every financial document posts one balanced Voucher via postVoucher(). Reports read
/// VoucherLine, never the source documents.
model Voucher {
  id           String      @id @default(cuid())
  companyId    String
  fiscalYearId String
  number       String // "JV-2083/84-0001"
  date         DateTime    @db.Date
  type         VoucherType
  narration    String?
  sourceType   String? // "SalesInvoice", "Receipt" … null for manual vouchers
  sourceId     String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  createdBy  User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines      VoucherLine[]

  @@unique([companyId, number])
  @@index([companyId, fiscalYearId, date])
  @@index([sourceType, sourceId])
}

model VoucherLine {
  id        String  @id @default(cuid())
  voucherId String
  ledgerId  String
  debit     Decimal @default(0) @db.Decimal(18, 2)
  credit    Decimal @default(0) @db.Decimal(18, 2)
  narration String?
  order     Int     @default(0)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger  Ledger  @relation(fields: [ledgerId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([ledgerId])
}

/// Gap-free sequential numbering per (company, fiscalYear, key). Locked increment.
model NumberSequence {
  id           String  @id @default(cuid())
  companyId    String
  fiscalYearId String?
  key          String // "voucher:JOURNAL", "invoice:SA" …
  nextValue    Int     @default(1)

  @@unique([companyId, fiscalYearId, key])
}

/// ─────────────────────────────  INVENTORY  ──────────────────────────
/// Mirrors the reference Inventory module. Current stock is DERIVED from StockMovement
/// (postStockMovement is the single writer) — never a mutable field.

enum ProductKind {
  GOODS
  SERVICE
  EXPENSE
}

enum ProductTaxBasis {
  INCLUSIVE
  EXCLUSIVE
}

/// Which balance-sheet inventory ledger a GOODS product's stock value sits in.
/// Purchases of RAW_MATERIAL land in "Raw Material Inventory" (INV-02) instead of
/// "Finished Inventory" (INV-01) — see src/server/purchase/service.ts and
/// src/server/manufacturing/ledgers.ts. Defaults to FINISHED_GOODS so every product
/// created before this field existed keeps posting exactly where it always has.
enum InventoryRole {
  FINISHED_GOODS
  RAW_MATERIAL
}

model ProductCategory {
  id          String    @id @default(cuid())
  companyId   String
  parentId    String?
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name])
  @@index([companyId, parentId])
}

model Unit {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  shortName      String
  description    String?
  acceptFraction Boolean  @default(false)
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryFor      Product[] @relation("ProductPrimaryUnit")
  subUnitFor      Product[] @relation("ProductSubUnit")
  tertiaryUnitFor Product[] @relation("ProductTertiaryUnit")

  @@unique([companyId, name])
  @@index([companyId])
}

model Warehouse {
  id        String    @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  batches        ProductBatch[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Product {
  id           String      @id @default(cuid())
  companyId    String
  kind         ProductKind @default(GOODS)
  name         String
  categoryId   String?
  hsnCode      String?
  sku          String
  reorderPoint Decimal?    @db.Decimal(18, 3)
  description  String?

  // Units — up to 3 levels. subUnitConversion = # of sub-units per 1 primary unit
  // (Docs/ASSUMPTIONS.md). tertiaryConversion = # of tertiary per 1 sub-unit.
  unitId             String
  subUnitId          String?
  subUnitConversion  Decimal? @db.Decimal(18, 6)
  tertiaryUnitId     String?
  tertiaryConversion Decimal? @db.Decimal(18, 6)

  purchasePrice Decimal @default(0) @db.Decimal(18, 2)
  sellingPrice  Decimal @default(0) @db.Decimal(18, 2)

  taxRateId     String?
  taxBasis      ProductTaxBasis @default(EXCLUSIVE)
  isNonTaxable  Boolean         @default(false)
  inventoryRole InventoryRole   @default(FINISHED_GOODS)

  // Optional attributes (reference product form)
  size             String?
  color            String?
  flavour          String?
  dftqcNo          String?
  madeImportedFrom String?
  expiryDate       DateTime? @db.Date

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit           Unit             @relation("ProductPrimaryUnit", fields: [unitId], references: [id], onDelete: Restrict)
  subUnit        Unit?            @relation("ProductSubUnit", fields: [subUnitId], references: [id], onDelete: SetNull)
  tertiaryUnit   Unit?            @relation("ProductTertiaryUnit", fields: [tertiaryUnitId], references: [id], onDelete: SetNull)
  taxRate        TaxRate?         @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  batches        ProductBatch[]
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, kind])
  @@index([companyId, categoryId])
}

model ProductBatch {
  id          String    @id @default(cuid())
  companyId   String
  productId   String
  warehouseId String
  batchNo     String
  expiryDate  DateTime? @db.Date
  createdAt   DateTime  @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([companyId, productId, warehouseId, batchNo])
  @@index([productId])
}

enum StockMovementKind {
  OPENING
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  MANUFACTURE_IN
  MANUFACTURE_OUT
}

/// The single source of truth for stock quantity. `qty` is signed
/// (positive = in, negative = out). Current on-hand = Σ qty per (product, warehouse[, batch]).
model StockMovement {
  id           String            @id @default(cuid())
  companyId    String
  fiscalYearId String?
  productId    String
  warehouseId  String
  batchId      String?
  date         DateTime          @db.Date
  kind         StockMovementKind
  qty          Decimal           @db.Decimal(18, 3)
  unitCost     Decimal           @default(0) @db.Decimal(18, 4)
  sourceType   String?
  sourceId     String?
  narration    String?
  createdById  String?
  createdAt    DateTime          @default(now())

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch     ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([companyId, productId, warehouseId])
  @@index([sourceType, sourceId])
  @@index([companyId, date])
}

enum InventoryAdjustmentType {
  INCREASE
  DECREASE
  DAMAGE
  EXPIRY
  RECOUNT
  OPENING
}

model InventoryAdjustment {
  id          String                  @id @default(cuid())
  companyId   String
  number      String
  date        DateTime                @db.Date
  type        InventoryAdjustmentType
  warehouseId String
  notes       String?
  createdById String?
  createdAt   DateTime                @default(now())

  company Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   InventoryAdjustmentLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model InventoryAdjustmentLine {
  id           String  @id @default(cuid())
  adjustmentId String
  productId    String
  batchId      String?
  qty          Decimal @db.Decimal(18, 3) // signed: + increase, - decrease
  order        Int     @default(0)

  adjustment InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
}

/// ───────────────────────────────  SALES  ────────────────────────────
/// Unified sales document (mirrors the reference `/invoices/` with `invoice_type`).
/// QUOTATION / SALES_ORDER are non-accounting drafts. INVOICE / CREDIT_NOTE post GL +
/// stock and are IMMUTABLE once created (Docs/vendor/INVOICE-IMMUTABILITY.txt) —
/// corrections happen only via a CREDIT_NOTE.

enum SalesDocType {
  QUOTATION
  SALES_ORDER
  INVOICE
  CREDIT_NOTE
}

enum SalesDocStatus {
  DRAFT // quotation / sales order, not yet converted
  OPEN // invoice with balance outstanding
  PARTIALLY_PAID
  PAID
  CONVERTED // quotation/SO converted to the next stage
  CANCELLED // credit-noted in full
  RETURNED // partially credit-noted
}

enum PaymentMode {
  CREDIT
  CASH
  BANK
  CHEQUE
  WALLET // eSewa / Khalti / POS
}

model SalesDoc {
  id           String       @id @default(cuid())
  companyId    String
  fiscalYearId String
  type         SalesDocType
  number       String // "SA-2083/84-0001", "QU-…", "CN-…"
  date         DateTime     @db.Date

  // Party — either an existing customer ledger, or a walk-in cash-sale name.
  customerLedgerId String?
  customerName     String? // for cash sales / display snapshot
  customerPan      String?

  deliveryDate    DateTime?   @db.Date
  creditDays      Int?
  referenceNo     String?
  paymentMode     PaymentMode @default(CREDIT)
  paymentLedgerId String? // cash/bank ledger when not on credit
  notes           String?

  convertedFromId String? // quotation → sales order → invoice chain
  reversesDocId   String? // credit note → the invoice it credits

  // Server-authoritative money (Docs/WORKFLOWS.md W4). All Decimal(18,2).
  subtotal          Decimal @default(0) @db.Decimal(18, 2) // Σ line gross (qty×rate)
  lineDiscountTotal Decimal @default(0) @db.Decimal(18, 2)
  invoiceDiscount   Decimal @default(0) @db.Decimal(18, 2) // header-level, on taxable base
  nonTaxableTotal   Decimal @default(0) @db.Decimal(18, 2)
  taxableTotal      Decimal @default(0) @db.Decimal(18, 2) // after all discounts, pre-VAT
  vatAmount         Decimal @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal @default(0) @db.Decimal(18, 2)
  amountPaid        Decimal @default(0) @db.Decimal(18, 2)

  status        SalesDocStatus @default(DRAFT)
  voucherId     String?        @unique // the GL voucher (INVOICE / CREDIT_NOTE only)
  cogsVoucherId String?        @unique
  createdById   String?
  createdAt     DateTime       @default(now())

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  items      SalesDocItem[]
  receipts   Receipt[]

  @@unique([companyId, number])
  @@index([companyId, type, date])
  @@index([customerLedgerId])
  @@index([convertedFromId])
  @@index([reversesDocId])
}

model SalesDocItem {
  id          String  @id @default(cuid())
  docId       String
  productId   String?
  description String // snapshot of product name (products can't be deleted while used, but snapshot anyway)
  hsCode      String?
  batchId     String?
  warehouseId String?

  qty      Decimal @db.Decimal(18, 3)
  rate     Decimal @db.Decimal(18, 4)
  discount Decimal @default(0) @db.Decimal(18, 2) // per-line, absolute

  taxRateId      String?
  taxRatePct     Decimal @default(0) @db.Decimal(7, 4) // snapshot
  isNonTaxable   Boolean @default(false)
  priceInclusive Boolean @default(false)

  // computed, stored for audit
  grossAmount Decimal @db.Decimal(18, 2) // qty × rate
  netAmount   Decimal @db.Decimal(18, 2) // gross − line discount (tax-exclusive base)
  lineVat     Decimal @default(0) @db.Decimal(18, 2)
  order       Int     @default(0)

  doc SalesDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([productId])
}

model Receipt {
  id           String   @id @default(cuid())
  companyId    String
  fiscalYearId String
  number       String // "RC-2083/84-0001"
  date         DateTime @db.Date

  customerLedgerId String
  paymentLedgerId  String // cash / bank ledger
  againstDocId     String? // the invoice being paid (optional — can be on-account)
  amount           Decimal     @db.Decimal(18, 2)
  paymentMode      PaymentMode @default(CASH)
  reference        String?
  notes            String?

  voucherId   String?  @unique
  createdById String?
  createdAt   DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  againstDoc SalesDoc?  @relation(fields: [againstDocId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([customerLedgerId])
}

/// ──────────────────────────────  PURCHASE  ───────────────────────────
/// Mirrors Sales, roles reversed (we are the buyer). Excise/custom duty are
/// CAPITALIZED into landed cost (added to Inventory), not expensed — standard
/// perpetual-inventory treatment. VAT here is Input VAT (Vat Receivable), the
/// mirror image of Sales' VAT Payable. Purchase Invoice is IMMUTABLE; corrections
/// go through a Debit Note (Docs/WORKFLOWS.md W5).

enum PurchaseDocType {
  PURCHASE_ORDER
  INVOICE
  DEBIT_NOTE
}

enum PurchaseDocStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  CONVERTED
  CANCELLED
  RETURNED
}

model PurchaseDoc {
  id           String          @id @default(cuid())
  companyId    String
  fiscalYearId String
  type         PurchaseDocType
  number       String // "PU-2083/84-0001", "PO-…", "DN-…"
  date         DateTime        @db.Date

  supplierLedgerId      String?
  supplierName          String? // display snapshot
  supplierPan           String?
  supplierInvoiceNumber String? // required for INVOICE — the vendor's own bill number

  deliveryDate    DateTime?   @db.Date
  referenceNo     String?
  paymentMode     PaymentMode @default(CREDIT)
  paymentLedgerId String?
  notes           String?

  convertedFromId String? // purchase order → invoice chain
  reversesDocId   String? // debit note → the invoice it debits

  subtotal          Decimal @default(0) @db.Decimal(18, 2)
  lineDiscountTotal Decimal @default(0) @db.Decimal(18, 2)
  invoiceDiscount   Decimal @default(0) @db.Decimal(18, 2)
  totalExciseDuty   Decimal @default(0) @db.Decimal(18, 2)
  totalCustomDuty   Decimal @default(0) @db.Decimal(18, 2)
  nonTaxableTotal   Decimal @default(0) @db.Decimal(18, 2)
  taxableTotal      Decimal @default(0) @db.Decimal(18, 2)
  vatAmount         Decimal @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal @default(0) @db.Decimal(18, 2)
  amountPaid        Decimal @default(0) @db.Decimal(18, 2)

  status      PurchaseDocStatus @default(DRAFT)
  voucherId   String?           @unique
  createdById String?
  createdAt   DateTime          @default(now())

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  items      PurchaseDocItem[]
  payments   SupplierPayment[]

  @@unique([companyId, number])
  @@index([companyId, type, date])
  @@index([supplierLedgerId])
  @@index([convertedFromId])
  @@index([reversesDocId])
}

model PurchaseDocItem {
  id          String  @id @default(cuid())
  docId       String
  productId   String?
  description String
  hsCode      String?
  batchId     String?
  warehouseId String?

  qty        Decimal @db.Decimal(18, 3)
  rate       Decimal @db.Decimal(18, 4)
  discount   Decimal @default(0) @db.Decimal(18, 2)
  exciseDuty Decimal @default(0) @db.Decimal(18, 2)
  customDuty Decimal @default(0) @db.Decimal(18, 2)

  taxRateId    String?
  taxRatePct   Decimal @default(0) @db.Decimal(7, 4)
  isNonTaxable Boolean @default(false)

  grossAmount    Decimal @db.Decimal(18, 2) // qty × rate
  netAmount      Decimal @db.Decimal(18, 2) // gross − line discount
  landedAmount   Decimal @db.Decimal(18, 2) // net + exciseDuty + customDuty — the taxable/capitalized base
  landedUnitCost Decimal @db.Decimal(18, 4) // landedAmount ÷ qty — feeds StockMovement.unitCost
  lineVat        Decimal @default(0) @db.Decimal(18, 2)
  order          Int     @default(0)

  doc PurchaseDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([productId])
}

model SupplierPayment {
  id           String   @id @default(cuid())
  companyId    String
  fiscalYearId String
  number       String // "PM-2083/84-0001"
  date         DateTime @db.Date

  supplierLedgerId String
  paymentLedgerId  String
  againstDocId     String?
  amount           Decimal     @db.Decimal(18, 2)
  paymentMode      PaymentMode @default(CASH)
  reference        String?
  notes            String?

  voucherId   String?  @unique
  createdById String?
  createdAt   DateTime @default(now())

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  againstDoc PurchaseDoc? @relation(fields: [againstDocId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([supplierLedgerId])
}

/// ───────────────────────────  FIXED ASSETS  ───────────────────────────
/// Each category maps 1:1 to a real NFRS ledger triple scraped from the reference
/// (Asset-at-cost / Accumulated Depreciation / Depreciation expense) — see
/// src/server/assets/ledgers.ts. FixedAsset is a SUBSIDIARY register (like Product for
/// Inventory): individual assets are never their own GL ledger. AssetDepreciationEntry is
/// the single source of truth for accumulated depreciation (never a mutable stored field),
/// mirroring StockMovement's "current value = Σ history" pattern.
enum AssetCategory {
  BUILDING
  COMPUTER
  FURNITURE_FIXTURE
  LAND
  LEASEHOLD_DEVELOPMENT
  OFFICE_EQUIPMENT
  OTHER_ASSETS
  PLANT_MACHINERY
  VEHICLES
}

enum DepreciationMethod {
  STRAIGHT_LINE
  WRITTEN_DOWN_VALUE
}

enum AssetStatus {
  ACTIVE
  DISPOSED
}

enum DisposalType {
  SOLD
  SCRAPPED
  LOST_STOLEN_BROKEN
}

model FixedAsset {
  id           String        @id @default(cuid())
  companyId    String
  fiscalYearId String // FY of acquisition
  assetCode    String // "FA-00001"
  name         String
  category     AssetCategory
  serialNumber String?
  location     String?
  notes        String?

  acquisitionDate     DateTime           @db.Date
  acquisitionCost     Decimal            @db.Decimal(18, 2)
  salvageValue        Decimal            @default(0) @db.Decimal(18, 2)
  depreciationMethod  DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths    Int? // STRAIGHT_LINE
  depreciationRatePct Decimal?           @db.Decimal(7, 4) // WRITTEN_DOWN_VALUE, annual %

  paymentMode      PaymentMode @default(CREDIT) // CASH/BANK -> paymentLedgerId; CREDIT -> supplierLedgerId
  paymentLedgerId  String?
  supplierLedgerId String?

  status            AssetStatus   @default(ACTIVE)
  disposalDate      DateTime?     @db.Date
  disposalType      DisposalType?
  disposalProceeds  Decimal?      @db.Decimal(18, 2)
  disposalLedgerId  String? // cash/bank credited with sale proceeds
  disposalVoucherId String?       @unique

  voucherId   String?  @unique // acquisition voucher
  createdById String?
  createdAt   DateTime @default(now())

  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear          FiscalYear               @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  depreciationEntries AssetDepreciationEntry[]

  @@unique([companyId, assetCode])
  @@index([companyId, category])
  @@index([companyId, status])
}

/// One row per asset per depreciation run (or per disposal catch-up run) — the subsidiary
/// ledger that accumulated depreciation is always derived from.
model AssetDepreciationEntry {
  id          String   @id @default(cuid())
  assetId     String
  runId       String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  amount      Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  asset FixedAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  run   DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([runId])
}

/// One GL voucher per batch run (grouped Dr Depreciation Expense / Cr Accum. Depreciation
/// per category) — or a single-asset run posted just before a disposal.
model DepreciationRun {
  id           String   @id @default(cuid())
  companyId    String
  fiscalYearId String
  asOfDate     DateTime @db.Date
  assetCount   Int
  totalAmount  Decimal  @db.Decimal(18, 2)
  voucherId    String   @unique
  createdById  String?
  createdAt    DateTime @default(now())

  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear               @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  entries    AssetDepreciationEntry[]

  @@index([companyId, fiscalYearId])
}

/// ──────────────────────────  MANUFACTURING  ────────────────────────────
/// BOM = "how much of each RAW_MATERIAL Product to consume, per batch, to produce
/// outputQty of a FINISHED_GOODS Product." A ProductionOrder runs a BOM some number of
/// `batches`, consuming components at their weighted-average cost (src/server/inventory/
/// cost.ts, reused as-is) and capitalizing materials + a labor allowance through the real
/// NFRS WIP Inventory ledger (INV-03) into Finished Inventory (INV-01) — see
/// src/server/manufacturing/ledgers.ts for the exact ledger codes, all scraped from the
/// reference COA, not invented.
model BillOfMaterial {
  id                String    @id @default(cuid())
  companyId         String
  outputProductId   String // a FINISHED_GOODS Product
  name              String
  outputQty         Decimal   @default(1) @db.Decimal(18, 3) // units of output per batch
  laborCostPerBatch Decimal   @default(0) @db.Decimal(18, 2)
  isActive          Boolean   @default(true)
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  deletedAt         DateTime?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  components       BomComponent[]
  productionOrders ProductionOrder[]

  @@unique([companyId, outputProductId, name])
  @@index([companyId, isActive])
}

model BomComponent {
  id                 String  @id @default(cuid())
  bomId              String
  componentProductId String // typically a RAW_MATERIAL Product
  qtyPerBatch        Decimal @db.Decimal(18, 3)
  order              Int     @default(0)

  bom BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([componentProductId])
}

model ProductionOrder {
  id              String   @id @default(cuid())
  companyId       String
  fiscalYearId    String
  number          String // "MO-2083/84-0001"
  date            DateTime @db.Date
  bomId           String
  outputProductId String
  warehouseId     String // consumed from and produced into
  batches         Decimal  @db.Decimal(18, 3)
  outputQty       Decimal  @db.Decimal(18, 3) // snapshot = bom.outputQty * batches
  materialCost    Decimal  @db.Decimal(18, 2) // snapshot = Σ component qty × its weighted-avg cost
  laborCost       Decimal  @db.Decimal(18, 2) // snapshot = bom.laborCostPerBatch * batches
  totalCost       Decimal  @db.Decimal(18, 2) // materialCost + laborCost
  unitCost        Decimal  @db.Decimal(18, 4) // totalCost / outputQty -> StockMovement.unitCost
  notes           String?
  voucherId       String?  @unique
  createdById     String?
  createdAt       DateTime @default(now())

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear            @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  bom        BillOfMaterial        @relation(fields: [bomId], references: [id], onDelete: Restrict)
  items      ProductionOrderItem[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

/// Snapshot of each component actually consumed by one ProductionOrder, at the weighted-
/// average cost in effect at that moment — same principle as SalesDocItem/PurchaseDocItem.
model ProductionOrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  componentProductId String
  qty                Decimal @db.Decimal(18, 3)
  unitCost           Decimal @db.Decimal(18, 4)
  amount             Decimal @db.Decimal(18, 2)

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// ───────────────────────────────  WORKSHOP  ────────────────────────────
/// Auto/repair vertical. A JobCard is a working document (like Quotation/SalesOrder — no
/// GL/stock impact of its own) that becomes a real Sales Invoice on "Complete & Bill", by
/// calling src/server/sales/service.ts's createInvoice() directly — reusing 100% of Sales'
/// already-verified GL/stock/COGS/VAT logic instead of duplicating it. Parts consume stock
/// and post COGS exactly like any other sale; labor lines behave like a SERVICE line (no
/// stock). Technician assignment is workshop-internal bookkeeping only — the invoice itself
/// has no notion of technicians.
enum JobCardStatus {
  OPEN
  BILLED
  CANCELLED
}

enum JobCardItemType {
  PART
  LABOR
}

model Technician {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  phone          String?
  specialization String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobItems JobCardItem[]

  @@index([companyId])
}

model JobCard {
  id           String   @id @default(cuid())
  companyId    String
  fiscalYearId String
  number       String // "JC-2083/84-0001"
  date         DateTime @db.Date

  customerLedgerId String?
  customerName     String?
  customerPhone    String?

  vehicleRegNo    String
  vehicleMake     String?
  vehicleModel    String?
  odometerReading Decimal? @db.Decimal(18, 2)
  complaint       String

  status      JobCardStatus @default(OPEN)
  invoiceId   String?       @unique
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  items      JobCardItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, vehicleRegNo])
}

model JobCardItem {
  id           String          @id @default(cuid())
  jobCardId    String
  itemType     JobCardItemType
  productId    String?
  technicianId String?
  description  String
  qty          Decimal         @db.Decimal(18, 3)
  rate         Decimal         @db.Decimal(18, 4)
  discount     Decimal         @default(0) @db.Decimal(18, 2)
  taxRateId    String?
  isNonTaxable Boolean         @default(false)
  order        Int             @default(0)

  jobCard    JobCard     @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([jobCardId])
}

/// ─────────────────────────────  AUDIT  ──────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  action    String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, …
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

/// ──────────────────────  NOTIFICATION & REMINDER  ───────────────────

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  title       String
  description String?
  remindAt    DateTime
  status      String   @default("PENDING") // PENDING, DONE, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// ────────────────────────  SETTINGS SUB-MODULES  ─────────────────────

/// Master list of bank names (Settings › Banks) — a dropdown source for
/// BankAccount and, where useful elsewhere, cheque/bank-transfer entry.
model Bank {
  id        String    @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts BankAccount[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// The company's own registered bank accounts (Settings › Bank Detail) —
/// optionally tied to a GL cash/bank Ledger, and referenced by
/// BillFooterSetting to print "pay to" details on invoices.
model BankAccount {
  id            String    @id @default(cuid())
  companyId     String
  bankId        String
  accountName   String
  accountNumber String
  branch        String?
  swiftCode     String?
  ledgerId      String?
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bank           Bank                @relation(fields: [bankId], references: [id], onDelete: Restrict)
  ledger         Ledger?             @relation(fields: [ledgerId], references: [id], onDelete: SetNull)
  billFooterUses BillFooterSetting[]

  @@index([companyId])
  @@index([bankId])
}

/// User-definable extra fields (Key Features: "Flexible User Definable Field
/// (UDF)"). MVP scope: definitions only — a module's entry form does not yet
/// render these dynamically (Docs/PROGRESS.md tracks the follow-on).
model CustomField {
  id        String    @id @default(cuid())
  companyId String
  module    String // "SALES_INVOICE", "PRODUCT", "CONTACT", …
  label     String
  fieldType String // TEXT | NUMBER | DATE | SELECT | CHECKBOX
  options   Json? // choice list for SELECT
  required  Boolean   @default(false)
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, module])
}

/// User-definable status labels (Settings › Custom Status). MVP scope:
/// definitions only — SalesDoc/PurchaseDoc.status stay on their fixed enum
/// (their values feed GL/workflow logic); these are additional descriptive
/// tags, not a replacement for the enum.
model CustomStatus {
  id        String    @id @default(cuid())
  companyId String
  module    String
  label     String
  color     String    @default("#64748b")
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, module])
}

/// Singleton per company (Settings › Barcode). Configuration only — no
/// barcode-symbol renderer is wired up yet (Docs/PROGRESS.md).
model BarcodeSetting {
  id            String   @id @default(cuid())
  companyId     String   @unique
  symbology     String   @default("CODE128")
  prefix        String?
  nextNumber    Int      @default(1)
  labelWidthMm  Int      @default(40)
  labelHeightMm Int      @default(25)
  showPrice     Boolean  @default(true)
  showName      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Singleton per company (Settings › Invoice Setting). Display/behavior
/// toggles read by the Sales/Purchase invoice detail+print pages and
/// pre-filled into the New Invoice form — NOT wired into GL rounding.
model InvoiceSetting {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  showHsCode         Boolean  @default(true)
  showDiscountColumn Boolean  @default(true)
  showBankDetails    Boolean  @default(true)
  showQrCode         Boolean  @default(true)
  defaultTermsText   String?
  defaultNotes       String?
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Column-mapping template for bulk invoice CSV import (Settings › Invoice
/// Import Setting). MVP scope: the mapping template only — the upload+parse
/// execution pipeline is a follow-on (Docs/PROGRESS.md).
model InvoiceImportTemplate {
  id        String    @id @default(cuid())
  companyId String
  name      String
  columnMap Json // { csvColumnHeader: targetField }
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Singleton per company (Settings › Bill Footer) — printed on the Sales/
/// Purchase invoice detail+print pages below the totals block.
model BillFooterSetting {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  termsAndConditions  String?
  bankAccountId       String?
  authorizedSignatory String?
  footerNote          String?
  updatedAt           DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
}
