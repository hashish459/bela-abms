// Bela ABMS — platform schema (Phase 3 foundation).
// Domain entities (invoices, products, vouchers, …) are added module-by-module later;
// see Docs/DATABASE.md. Only observed structures are modelled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ─────────────────────────────  TENANCY  ─────────────────────────────

model Company {
  id                    String   @id @default(cuid())
  name                  String
  subdomain             String   @unique
  address               String?
  allowsBranchCreation   Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  branches      Branch[]
  fiscalYears   FiscalYear[]
  roles         Role[]
  userLinks     UserCompany[]
  auditLogs     AuditLog[]
  reminders     Reminder[]
  notifications Notification[]
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model FiscalYear {
  id        String   @id @default(cuid())
  companyId String
  name      String   // e.g. "2083-84"
  startDate DateTime // Gregorian equivalent of BS start
  endDate   DateTime
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

/// ─────────────────────────────  IDENTITY  ────────────────────────────

/// Reference JWT carries user_type "AD" (Admin). Full option set not yet observed
/// (Docs/ASSUMPTIONS.md A7). Kept as free string; ADMIN bypasses permission checks.
model User {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?
  passwordHash String
  userType     String    @default("STAFF")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  companyLinks  UserCompany[]
  roleLinks     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  reminders     Reminder[]
  notifications Notification[]
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

model UserCompany {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  isDefault Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// ────────────────────────  ROLES & PERMISSIONS  ─────────────────────

/// Roles are per-company and free-text named (Admin, Cashier, Retailer, Storekeeper, …).
model Role {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userLinks   UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// The 78 UI modules from Settings › User & Permissions, grouped like the nav.
model PermissionModule {
  id        String @id @default(cuid())
  groupKey  String // "sales", "purchase", …
  groupName String // "Sales"
  key       String @unique // "sales.sales_invoice"
  label     String // "Sales Invoice"
  order     Int    @default(0)

  rolePermissions RolePermission[]

  @@index([groupKey])
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  moduleId  String
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module PermissionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@index([moduleId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// ─────────────────────────────  AUTH  ───────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// ────────────────────────  NAVIGATION (data-driven)  ────────────────

model MenuItem {
  id            String  @id @default(cuid())
  parentId      String?
  title         String
  slug          String  @unique
  route         String?
  icon          String?
  order         Int     @default(0)
  isActive      Boolean @default(true)
  isExternal    Boolean @default(false)
  permissionKey String? // -> PermissionModule.key; null = always visible

  parent   MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuChildren")

  @@index([parentId])
}

/// ─────────────────────────────  AUDIT  ──────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  action    String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, …
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

/// ──────────────────────  NOTIFICATION & REMINDER  ───────────────────

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  title       String
  description String?
  remindAt    DateTime
  status      String   @default("PENDING") // PENDING, DONE, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
