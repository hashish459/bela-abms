// Bela ABMS — platform schema (Phase 3 foundation).
// Domain entities (invoices, products, vouchers, …) are added module-by-module later;
// see Docs/DATABASE.md. Only observed structures are modelled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ─────────────────────────────  TENANCY  ─────────────────────────────

model Company {
  id                   String    @id @default(cuid())
  name                 String
  subdomain            String    @unique
  address              String?
  allowsBranchCreation Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  branches      Branch[]
  fiscalYears   FiscalYear[]
  taxRates      TaxRate[]
  info          CompanyInfo?
  roles         Role[]
  userLinks     UserCompany[]
  auditLogs     AuditLog[]
  reminders     Reminder[]
  notifications Notification[]
  accountHeads  AccountHead[]
  accountGroups AccountGroup[]
  ledgers       Ledger[]
  vouchers      Voucher[]
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  name      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model FiscalYear {
  id          String   @id @default(cuid())
  companyId   String
  name        String // Bikram Sambat label, e.g. "2083-84"
  startDate   DateTime @db.Date // stored as AD (Gregorian); UI shows BS
  endDate     DateTime @db.Date
  description String?
  active      Boolean  @default(false)
  isClosed    Boolean  @default(false) // year-end closed; opening carried forward
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers Voucher[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Tax rates ("list published by IRD" in the reference). Nepal: VAT 13% + 0% exempt.
model TaxRate {
  id        String    @id @default(cuid())
  companyId String
  name      String // "VAT 13%", "VAT Exempt", "Non-Taxable"
  ratePct   Decimal   @db.Decimal(7, 4) // 13.0000
  isNoTax   Boolean   @default(false) // "No Tax" flag — excludes from VAT base
  isSystem  Boolean   @default(false) // seeded IRD rate; not deletable
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

/// One row per company: legal identity, IRD registration, branding assets.
/// Mirrors Settings › Company Info in the reference.
model CompanyInfo {
  id        String @id @default(cuid())
  companyId String @unique

  legalName   String
  displayName String?
  phone       String
  phone2      String?
  email       String
  website     String?
  panNumber   String
  eximCode    String?

  // IRD Central Billing Monitoring System — integration is stubbed in v1 (ASSUMPTIONS A16).
  cbmsUsername             String?
  cbmsPasswordCiphertext   String? // encrypted at rest; never returned to the client
  registeredWithVat        Boolean @default(true)
  separatePurchaseSalesTax Boolean @default(false)
  syncWithIrd              Boolean @default(false)

  registeredAddress  String
  registeredAddress2 String?

  logoUrl      String?
  stampUrl     String?
  paymentQrUrl String?
  signatureUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// ─────────────────────────────  IDENTITY  ────────────────────────────

/// Reference JWT carries user_type "AD" (Admin). Full option set not yet observed
/// (Docs/ASSUMPTIONS.md A7). Kept as free string; ADMIN bypasses permission checks.
model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  passwordHash String
  userType     String     @default("STAFF")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  companyLinks  UserCompany[]
  roleLinks     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  reminders     Reminder[]
  notifications Notification[]
  vouchers      Voucher[]
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

model UserCompany {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  isDefault Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// ────────────────────────  ROLES & PERMISSIONS  ─────────────────────

/// Roles are per-company and free-text named (Admin, Cashier, Retailer, Storekeeper, …).
model Role {
  id        String    @id @default(cuid())
  companyId String
  name      String
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userLinks   UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// The 78 UI modules from Settings › User & Permissions, grouped like the nav.
model PermissionModule {
  id        String @id @default(cuid())
  groupKey  String // "sales", "purchase", …
  groupName String // "Sales"
  key       String @unique // "sales.sales_invoice"
  label     String // "Sales Invoice"
  order     Int    @default(0)

  rolePermissions RolePermission[]

  @@index([groupKey])
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  moduleId  String
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module PermissionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@index([moduleId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// ─────────────────────────────  AUTH  ───────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// ────────────────────────  NAVIGATION (data-driven)  ────────────────

model MenuItem {
  id            String  @id @default(cuid())
  parentId      String?
  title         String
  slug          String  @unique
  route         String?
  icon          String?
  order         Int     @default(0)
  isActive      Boolean @default(true)
  isExternal    Boolean @default(false)
  permissionKey String? // -> PermissionModule.key; null = always visible

  parent   MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuChildren")

  @@index([parentId])
}

/// ────────────────────  ACCOUNTS / GENERAL LEDGER  ───────────────────
/// Mirrors the reference's 3-level NFRS chart of accounts
/// (AccountHead → AccountGroup → Ledger). See Docs/REFERENCE-API-MAP.md.

enum AccountType {
  AS // Assets
  LI // Liabilities
  EQ // Equity
  IN // Income
  EX // Expense
}

enum CurrentType {
  CU // Current
  NC // Non-Current
  O // not applicable (P&L accounts)
}

enum FinancialType {
  FI // Financial
  NF // Non-Financial
  O // not applicable
}

enum BalanceType {
  DR
  CR
}

enum ContactKind {
  CUSTOMER
  SUPPLIER
  BOTH
}

model AccountHead {
  id            String        @id @default(cuid())
  companyId     String
  code          String // "ADE", "CCE", "TRR" …
  name          String
  accountType   AccountType
  currentType   CurrentType   @default(O)
  financialType FinancialType @default(O)
  isSystem      Boolean       @default(false) // NFRS-reserved; not deletable
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groups  AccountGroup[]

  @@unique([companyId, code])
  @@index([companyId, accountType])
}

model AccountGroup {
  id            String   @id @default(cuid())
  companyId     String
  accountHeadId String
  code          String // "ADE-01"
  name          String
  isSystem      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountHead AccountHead @relation(fields: [accountHeadId], references: [id], onDelete: Cascade)
  ledgers     Ledger[]

  @@unique([companyId, code])
  @@index([accountHeadId])
}

/// Level-3 posting account. Customers/suppliers ARE ledgers (under Trade Receivable /
/// Trade Payable), carrying the party fields.
model Ledger {
  id             String      @id @default(cuid())
  companyId      String
  accountGroupId String
  code           String // "CCE-01-0001"
  name           String
  openingBalance Decimal     @default(0) @db.Decimal(18, 2)
  openingType    BalanceType @default(DR)
  isSystem       Boolean     @default(false)
  isActive       Boolean     @default(true)

  // Party fields — populated when this ledger is a customer/supplier contact.
  contactKind ContactKind?
  panNumber   String?
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal?     @db.Decimal(18, 2)
  iecNo       String?
  gstin       String?
  bankName    String?
  bankAccount String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountGroup AccountGroup  @relation(fields: [accountGroupId], references: [id], onDelete: Restrict)
  voucherLines VoucherLine[]

  @@unique([companyId, code])
  @@index([accountGroupId])
  @@index([companyId, contactKind])
}

enum VoucherType {
  OPENING
  JOURNAL
  CONTRA
  STOCK
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  EXPENSE
}

/// Every financial document posts one balanced Voucher via postVoucher(). Reports read
/// VoucherLine, never the source documents.
model Voucher {
  id           String      @id @default(cuid())
  companyId    String
  fiscalYearId String
  number       String // "JV-2083/84-0001"
  date         DateTime    @db.Date
  type         VoucherType
  narration    String?
  sourceType   String? // "SalesInvoice", "Receipt" … null for manual vouchers
  sourceId     String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  createdBy  User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines      VoucherLine[]

  @@unique([companyId, number])
  @@index([companyId, fiscalYearId, date])
  @@index([sourceType, sourceId])
}

model VoucherLine {
  id        String  @id @default(cuid())
  voucherId String
  ledgerId  String
  debit     Decimal @default(0) @db.Decimal(18, 2)
  credit    Decimal @default(0) @db.Decimal(18, 2)
  narration String?
  order     Int     @default(0)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger  Ledger  @relation(fields: [ledgerId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([ledgerId])
}

/// Gap-free sequential numbering per (company, fiscalYear, key). Locked increment.
model NumberSequence {
  id           String  @id @default(cuid())
  companyId    String
  fiscalYearId String?
  key          String // "voucher:JOURNAL", "invoice:SA" …
  nextValue    Int     @default(1)

  @@unique([companyId, fiscalYearId, key])
}

/// ─────────────────────────────  AUDIT  ──────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  action    String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, …
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

/// ──────────────────────  NOTIFICATION & REMINDER  ───────────────────

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  title       String
  description String?
  remindAt    DateTime
  status      String   @default("PENDING") // PENDING, DONE, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
